{
  "name": "VooAlerta — Monitoramento de Passagens",
  "nodes": [
    {
      "id": "1",
      "name": "Cron — A cada hora",
      "type": "n8n-nodes-base.cron",
      "position": [240, 300],
      "parameters": {
        "triggerTimes": {
          "item": [{ "mode": "everyHour" }]
        }
      }
    },
    {
      "id": "2",
      "name": "Supabase — Buscar rotas unicas",
      "type": "n8n-nodes-base.httpRequest",
      "position": [460, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/rotas_unicas",
        "headers": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        }
      }
    },
    {
      "id": "3",
      "name": "Split — Por rota",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [680, 300],
      "parameters": { "batchSize": 1 }
    },
    {
      "id": "4",
      "name": "Supabase — Cache valido?",
      "type": "n8n-nodes-base.httpRequest",
      "position": [900, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/price_cache?origem=eq.{{ $json.origem }}&destino=eq.{{ $json.destino }}&data_ida=eq.{{ $json.data_ida }}&atualizado_em=gte.{{ new Date(Date.now() - 6*60*60*1000).toISOString() }}&limit=1",
        "headers": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        }
      }
    },
    {
      "id": "5",
      "name": "IF — Cache recente?",
      "type": "n8n-nodes-base.if",
      "position": [1120, 300],
      "parameters": {
        "conditions": {
          "number": [{
            "value1": "={{ $json.length }}",
            "operation": "larger",
            "value2": 0
          }]
        }
      }
    },
    {
      "id": "6",
      "name": "Serpapi — Buscar todos os voos",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1340, 440],
      "parameters": {
        "method": "GET",
        "url": "https://serpapi.com/search",
        "queryParameters": {
          "parameters": [
            { "name": "engine",        "value": "google_flights" },
            { "name": "departure_id",  "value": "={{ $('Split — Por rota').item.json.origem }}" },
            { "name": "arrival_id",    "value": "={{ $('Split — Por rota').item.json.destino }}" },
            { "name": "outbound_date", "value": "={{ $('Split — Por rota').item.json.data_ida }}" },
            { "name": "return_date",   "value": "={{ $('Split — Por rota').item.json.data_volta }}" },
            { "name": "currency",      "value": "BRL" },
            { "name": "hl",            "value": "pt" },
            { "name": "api_key",       "value": "={{ $env.SERPAPI_KEY }}" }
          ]
        }
      }
    },
    {
      "id": "7",
      "name": "Code — Salvar voos no cache",
      "type": "n8n-nodes-base.code",
      "position": [1560, 440],
      "parameters": {
        "jsCode": "const rota = $('Split — Por rota').item.json;\nconst voos = [\n  ...($input.item.json.best_flights ?? []),\n  ...($input.item.json.other_flights ?? [])\n];\n\nconst agora = new Date().toISOString();\n\nconst registros = voos.map(v => {\n  const voo = v.flights?.[0] ?? {};\n  const partida = voo.departure_airport?.time ?? '';\n  const chegada = voo.arrival_airport?.time ?? '';\n  const horarioPartida = partida ? new Date(partida).toTimeString().slice(0,5) : null;\n  const horarioChegada = chegada ? new Date(chegada).toTimeString().slice(0,5) : null;\n  return {\n    origem: rota.origem,\n    destino: rota.destino,\n    data_ida: rota.data_ida,\n    data_volta: rota.data_volta ?? null,\n    companhia: v.airline ?? voo.airline ?? null,\n    preco: v.price ?? null,\n    horario_partida: horarioPartida,\n    horario_chegada: horarioChegada,\n    duracao_min: v.total_duration ?? null,\n    escalas: (v.flights?.length ?? 1) - 1,\n    link: v.booking_token ?? null,\n    atualizado_em: agora\n  };\n});\n\nreturn registros.map(r => ({ json: r }));"
      }
    },
    {
      "id": "8",
      "name": "Supabase — Inserir no cache",
      "type": "n8n-nodes-base.httpRequest",
      "position": [1780, 440],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/price_cache",
        "headers": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type",  "value": "application/json" },
            { "name": "Prefer",        "value": "resolution=merge-duplicates" }
          ]
        },
        "body": {
          "contentType": "json",
          "body": "={{ JSON.stringify($json) }}"
        }
      }
    },
    {
      "id": "9",
      "name": "Supabase — Buscar alertas da rota",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2000, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/alerts_ativos?origem=eq.{{ $('Split — Por rota').item.json.origem }}&destino=eq.{{ $('Split — Por rota').item.json.destino }}&data_ida=eq.{{ $('Split — Por rota').item.json.data_ida }}",
        "headers": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        }
      }
    },
    {
      "id": "10",
      "name": "Split — Por alerta",
      "type": "n8n-nodes-base.splitInBatches",
      "position": [2220, 300],
      "parameters": { "batchSize": 1 }
    },
    {
      "id": "11",
      "name": "Supabase — Voos do cache filtrados",
      "type": "n8n-nodes-base.httpRequest",
      "position": [2440, 300],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/price_cache?origem=eq.{{ $json.origem }}&destino=eq.{{ $json.destino }}&data_ida=eq.{{ $json.data_ida }}&order=preco.asc",
        "headers": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        }
      }
    },
    {
      "id": "12",
      "name": "Code — Filtrar horario e menor preco",
      "type": "n8n-nodes-base.code",
      "position": [2660, 300],
      "parameters": {
        "jsCode": "const alerta = $('Split — Por alerta').item.json;\nconst voos = $input.item.json;\n\n// Filtra por horário mínimo\nlet voosFiltrados = voos;\nif (alerta.horario_minimo) {\n  voosFiltrados = voos.filter(v => {\n    if (!v.horario_partida) return false;\n    return v.horario_partida >= alerta.horario_minimo;\n  });\n}\n\n// Filtra só direto se necessário\nif (alerta.so_direto) {\n  voosFiltrados = voosFiltrados.filter(v => v.escalas === 0);\n}\n\n// Pega o menor preço\nconst melhorVoo = voosFiltrados.sort((a, b) => a.preco - b.preco)[0] ?? null;\nconst preco_atual = melhorVoo?.preco ?? 999999;\n\nreturn [{ json: {\n  ...alerta,\n  preco_atual,\n  melhor_voo: melhorVoo\n}}];"
      }
    },
    {
      "id": "13",
      "name": "IF — Abaixo da meta?",
      "type": "n8n-nodes-base.if",
      "position": [2880, 300],
      "parameters": {
        "conditions": {
          "number": [{
            "value1": "={{ $json.preco_atual }}",
            "operation": "smallerEqual",
            "value2": "={{ $json.meta }}"
          }]
        }
      }
    },
    {
      "id": "14",
      "name": "Supabase — Ultima notificacao",
      "type": "n8n-nodes-base.httpRequest",
      "position": [3100, 220],
      "parameters": {
        "method": "GET",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/notifications?alert_id=eq.{{ $json.id }}&enviado_em=gte.{{ new Date(Date.now() - 6*60*60*1000).toISOString() }}&order=enviado_em.desc&limit=1",
        "headers": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" }
          ]
        }
      }
    },
    {
      "id": "15",
      "name": "IF — Ja notificou nas ultimas 6h?",
      "type": "n8n-nodes-base.if",
      "position": [3320, 220],
      "parameters": {
        "conditions": {
          "number": [{
            "value1": "={{ $json.length }}",
            "operation": "equal",
            "value2": 0
          }]
        }
      }
    },
    {
      "id": "16",
      "name": "CallMeBot — Enviar WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "position": [3540, 140],
      "parameters": {
        "method": "GET",
        "url": "https://api.callmebot.com/whatsapp.php",
        "queryParameters": {
          "parameters": [
            { "name": "phone",  "value": "={{ $('Split — Por alerta').item.json.whatsapp }}" },
            { "name": "text",   "value": "=✈ {{ $('Split — Por alerta').item.json.origem }} → {{ $('Split — Por alerta').item.json.destino }} por R$ {{ $('Code — Filtrar horario e menor preco').item.json.preco_atual }}!\\n\\nVoo das {{ $('Code — Filtrar horario e menor preco').item.json.melhor_voo.horario_partida }} · {{ $('Code — Filtrar horario e menor preco').item.json.melhor_voo.companhia }} · {{ $('Code — Filtrar horario e menor preco').item.json.melhor_voo.escalas === 0 ? 'direto' : $('Code — Filtrar horario e menor preco').item.json.melhor_voo.escalas + ' escala(s)' }}\\n\\nSua meta era R$ {{ $('Split — Por alerta').item.json.meta }}. Corre comprar! 🎉" },
            { "name": "apikey", "value": "={{ $env.CALLMEBOT_KEY }}" }
          ]
        }
      }
    },
    {
      "id": "17",
      "name": "Supabase — Registrar notificacao",
      "type": "n8n-nodes-base.httpRequest",
      "position": [3760, 140],
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SUPABASE_URL }}/rest/v1/notifications",
        "headers": {
          "parameters": [
            { "name": "apikey",        "value": "={{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Authorization", "value": "=Bearer {{ $env.SUPABASE_SERVICE_KEY }}" },
            { "name": "Content-Type",  "value": "application/json" }
          ]
        },
        "body": {
          "contentType": "json",
          "body": "={\n  \"alert_id\": \"{{ $('Split — Por alerta').item.json.id }}\",\n  \"user_id\": \"{{ $('Split — Por alerta').item.json.user_id }}\",\n  \"preco\": {{ $('Code — Filtrar horario e menor preco').item.json.preco_atual }}\n}"
        }
      }
    }
  ],
  "connections": {
    "Cron — A cada hora":                  { "main": [[{ "node": "Supabase — Buscar rotas unicas",       "type": "main", "index": 0 }]] },
    "Supabase — Buscar rotas unicas":      { "main": [[{ "node": "Split — Por rota",                     "type": "main", "index": 0 }]] },
    "Split — Por rota":                    { "main": [[{ "node": "Supabase — Cache valido?",              "type": "main", "index": 0 }]] },
    "Supabase — Cache valido?":            { "main": [[{ "node": "IF — Cache recente?",                   "type": "main", "index": 0 }]] },
    "IF — Cache recente?":                 { "main": [
      [{ "node": "Supabase — Buscar alertas da rota", "type": "main", "index": 0 }],
      [{ "node": "Serpapi — Buscar todos os voos",    "type": "main", "index": 0 }]
    ]},
    "Serpapi — Buscar todos os voos":      { "main": [[{ "node": "Code — Salvar voos no cache",           "type": "main", "index": 0 }]] },
    "Code — Salvar voos no cache":         { "main": [[{ "node": "Supabase — Inserir no cache",           "type": "main", "index": 0 }]] },
    "Supabase — Inserir no cache":         { "main": [[{ "node": "Supabase — Buscar alertas da rota",     "type": "main", "index": 0 }]] },
    "Supabase — Buscar alertas da rota":   { "main": [[{ "node": "Split — Por alerta",                    "type": "main", "index": 0 }]] },
    "Split — Por alerta":                  { "main": [[{ "node": "Supabase — Voos do cache filtrados",    "type": "main", "index": 0 }]] },
    "Supabase — Voos do cache filtrados":  { "main": [[{ "node": "Code — Filtrar horario e menor preco",  "type": "main", "index": 0 }]] },
    "Code — Filtrar horario e menor preco":{ "main": [[{ "node": "IF — Abaixo da meta?",                  "type": "main", "index": 0 }]] },
    "IF — Abaixo da meta?":                { "main": [
      [{ "node": "Supabase — Ultima notificacao",     "type": "main", "index": 0 }],
      []
    ]},
    "Supabase — Ultima notificacao":       { "main": [[{ "node": "IF — Ja notificou nas ultimas 6h?",     "type": "main", "index": 0 }]] },
    "IF — Ja notificou nas ultimas 6h?":   { "main": [
      [{ "node": "CallMeBot — Enviar WhatsApp",       "type": "main", "index": 0 }],
      []
    ]},
    "CallMeBot — Enviar WhatsApp":         { "main": [[{ "node": "Supabase — Registrar notificacao",      "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1" }
}
