{
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "buildCommand": "node scripts/generate-env.js && npm run build:prod",
  "outputDirectory": "dist/vooalerta/browser",
  "installCommand": "npm install",
  "framework": "angular",
  "functions": {
    "api/scrape-flight.js": {
      "maxDuration": 15
    },
    "api/job-status.js": {
      "maxDuration": 10
    }
  }
}
